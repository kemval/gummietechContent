# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which scoring/drafting backend to use: gemini (default) or groq.
LLM_PROVIDER=gemini

# Gemini (Layer 2 scoring) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use Flash Lite: the code's default, Gemini 3.5 Flash, allows only 20
# requests a day and one scoring pass needs 40-80. Flash Lite allows 500.
# CI pins the same model in ingest.yml.
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq — free-tier fallback scoring provider — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=                    # optional; see src/groq_llm.py DEFAULT_MODEL

# OpenRouter — optional last fallback, `:free` model ids only (the code
# refuses any other). Never add credit. — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=              # optional; see src/openrouter_llm.py DEFAULT_MODEL

# Google Sheets (database) — path to service account JSON
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=

# Telegram — how the daily run reaches you, and how you tell it a post is
# live. Create the bot by messaging @BotFather; get the chat id by messaging
# your bot once, then reading
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The zone published_at is dated in when you tap the button. CI runs in UTC,
# so without this a late-evening post is filed under the next day.
# PUBLISH_TZ=America/Bogota
