# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which scoring/drafting backend to use: gemini (default) or groq.
LLM_PROVIDER=gemini

# Gemini (Layer 2 scoring) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=                  # optional; see src/gemini.py DEFAULT_MODEL

# Groq — free-tier fallback scoring provider — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=                    # optional; see src/groq_llm.py DEFAULT_MODEL

# Google Sheets (database) — path to service account JSON
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=
